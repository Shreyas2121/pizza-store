# Copy to backend/.env and replace placeholders. Do not commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/pizzastore
# Optional direct Neon URL for migrations (runtime can use the pooled URL).
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
# Optional local data root. Render Free uses bundled images + Cloudinary instead.
# DATA_DIRECTORY=/absolute/local/data/path
IMAGE_STORAGE=local
# On Render Free use IMAGE_STORAGE=cloudinary and supply all three server secrets.
# CLOUDINARY_CLOUD_NAME=your-existing-stay-mate-cloud-name
# CLOUDINARY_API_KEY=replace-me
# CLOUDINARY_API_SECRET=replace-me
# Run posting/recovery while the backend is awake (enabled in render.yaml).
MAINTENANCE_ENABLED=false
JWT_SECRET=replace-with-a-long-random-local-signing-secret
FE_URL=http://localhost:3150
PAYMENT_PROVIDER_MODE=simulator
RAZORPAY_ENABLED=false
# Production requires a dedicated metrics bearer token of at least 32 characters.
# METRICS_BEARER_TOKEN=replace-with-a-dedicated-random-token
# PAYROLL_ENCRYPTION_KEY=replace-with-a-separate-random-key-of-at-least-32-characters
# Optional Test Mode: set all three together and select razorpay_test.
# RAZORPAY_KEY_ID=rzp_test_replace-me
# RAZORPAY_KEY_SECRET=replace-me
# RAZORPAY_WEBHOOK_SECRET=replace-me
