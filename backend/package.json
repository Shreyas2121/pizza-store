{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src/",
    "test": "vitest run src --pool=threads",
    "test:watch": "vitest src --pool=threads",
    "dev": "nodemon src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "generate:types": "ts-node src/generate-types.ts",
    "seed:users": "ts-node src/scripts/user.ts",
    "seed:addresses": "ts-node src/scripts/address.ts",
    "seed:orders": "ts-node src/scripts/order.ts",
    "seed:catalog": "ts-node src/scripts/catalog.ts",
    "seed:promotions": "ts-node src/scripts/promotions.ts",
    "seed:default-store": "ts-node src/scripts/default-store.ts",
    "seed:staff": "ts-node src/scripts/staff.ts",
    "payments:reconcile": "ts-node src/scripts/reconcile-payments.ts",
    "inventory:reconcile-reservations": "ts-node src/scripts/reconcile-inventory-reservations.ts",
    "promotions:cleanup-media": "ts-node src/scripts/cleanup-promotion-media.ts",
    "finance:post-events": "ts-node src/scripts/post-financial-events.ts",
    "finance:reconcile-fixture": "ts-node src/scripts/reconcile-financial-scenario.ts",
    "demo:reset": "ts-node src/scripts/demo-reset.ts --confirm-local-demo-reset",
    "seed": "ts-node src/scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.2.0",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "socket.io-msgpack-parser": "3.0.2",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
